# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for account deletion + cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Random 32+ char string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
# Public site URL (no trailing slash), used for email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
